<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RoadWise" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="colorPrimaryVariant">@color/brand_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_amber</item>
        <item name="colorSecondaryVariant">@color/brand_amber_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:colorBackground">@color/pearl_background</item>
        <item name="colorSurface">@color/pearl_surface</item>
        <item name="colorOnBackground">@color/text_high_emphasis_light</item>
        <item name="colorOnSurface">@color/text_high_emphasis_light</item>

        <item name="glassSurface">@color/pearl_surface_glass</item>
        <item name="glassSurfaceDeep">@color/pearl_surface_glass</item>
        <item name="glassBorder">@color/glass_border_light</item>
        <item name="textFaded">@color/text_med_emphasis_light</item>

        <item name="android:statusBarColor">@color/pearl_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>
